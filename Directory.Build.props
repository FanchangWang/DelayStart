<Project>

  <!--
    DelayStart 仓库级编译属性。
    规范见 docs/coding-standards.md 第二节；架构约束见 docs/architecture.md 1.1 / 1.3。

    注意：本文件对整个仓库生效（含测试项目）。项目级差异一律写在各项目的 .csproj 里，
    不要在这里加 Condition 分支——那会让"哪些项目适用哪条规则"变得不可追溯。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      ★ 版本号唯一来源（D60-5）。安装脚本从本文件解析它，再用 ISCC /DAppVersion 注入 iss，
      保证「程序集版本 = 文件版本 = 安装程序版本」三者同源。
      ⚠️ 改版本只改这一行 —— installer/DelayStart.iss 里的 AppVersion 只是缺省值，
      手工编译时才生效；正式构建一律由 installer/build-installer.ps1 传入。
    -->
    <Version>0.4.0</Version>

    <!-- 验收标准是零警告。不要用 #pragma warning disable 绕过。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 内部成员不强制 XML 文档 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      🔴 必须为 false。原值 true 是 Phase 0 的误判（理由写在"省体积"，已作废）。

      语义澄清：invariant 模式不是"不要多语言"，而是**不存在任何 culture** ——
      任何 CultureInfo 构造都会抛 CultureNotFoundException。而
      Microsoft.Win32.TaskScheduler.Trigger 的静态构造器会
      CreateSpecificCulture("en") 来格式化任务 XML 日期 → 一旦按 FR-11.3 用
      TaskService.RegisterTaskDefinition 注册计划任务，必抛
      TypeInitializationException（D34 真机实测，manager.log 有完整异常链）。

      体积代价实测 ≈ 0：Windows 上 .NET 用系统 C:\Windows\System32\icu.dll，
      输出目录 ICU 文件 0 个、140.8 MB 不变。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
