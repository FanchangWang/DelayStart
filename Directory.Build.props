<Project>

  <!--
    DelayStart 仓库级编译属性。
    规范见 docs/coding-standards.md 第二节；架构约束见 docs/architecture.md 1.1 / 1.3。

    注意：本文件对整个仓库生效（含测试项目）。项目级差异一律写在各项目的 .csproj 里，
    不要在这里加 Condition 分支——那会让"哪些项目适用哪条规则"变得不可追溯。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 验收标准是零警告。不要用 #pragma warning disable 绕过。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 内部成员不强制 XML 文档 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 本项目无多语言需求，省体积（调度端 AOT 体积敏感，见 architecture.md 8.1） -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
