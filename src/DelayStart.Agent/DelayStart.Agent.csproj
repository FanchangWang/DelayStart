<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ★ D38（2026-09-20 用户批复）：普通用户代理进程。
      提权管理员调度器不再直接降权创建进程（CreateProcessWithTokenW 经 seclogon
      服务中转，真机实测返回 ACCESS_DENIED(5) 且会无响应挂起），改为把启动命令
      经命名管道发给本代理 —— 代理由计划任务以**普通用户**身份启动，天然持有
      交互用户令牌，Process.Start 即是降权，零令牌操作。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DelayStart.Agent</RootNamespace>
    <AssemblyName>DelayStart.Agent</AssemblyName>

    <!-- WinExe：登录瞬间启动不能闪控制台黑框（与调度端同理）。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!--
    ★ 刻意**不引用 Core**（用户批复："普通用户身份也可以单独写个代码，因为逻辑不多，
    可以不跟现在的调度器一份代码"）。本工程自包含：协议模型 + 极简文件日志 +
    命名管道服务器，全部在 Program.cs / AgentProtocol.cs 两个文件里。
  -->

  <ItemGroup>
    <!--
      ★ 与 Scheduler 同款：本机 VS 2026 的 vcvarsall 未自动带出 Windows SDK 的
        um/ucrt 库路径（LNK1181: advapi32.lib），这里显式补上（10.0.26100.0）。
    -->
    <AdditionalNativeLibraryDirectories Include="C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0\um\x64" />
    <AdditionalNativeLibraryDirectories Include="C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0\ucrt\x64" />
  </ItemGroup>

</Project>
