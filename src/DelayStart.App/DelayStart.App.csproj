<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      TFM 的 26100 是 WinUI 模板产出值（TargetPlatformVersion），保持不动；
      支持下限由 TargetPlatformMinVersion 控制，与 NFR-5.1（Windows 10 21H2+）对齐。
      TargetPlatformMinVersion 同时决定 SupportedOSPlatformVersion，
      因此 CA1416 会在编译期拦住"用了 Win11 才有的 API"这类错误。
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>

    <RootNamespace>DelayStart.App</RootNamespace>
    <!-- 产出 DelayStart.exe，与安装目录布局一致（architecture.md 1.5 / build-and-test.md 7.1） -->
    <AssemblyName>DelayStart</AssemblyName>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      ★ D61：把应用图标嵌进 exe。
      原先只声明了 <Content Include="Assets\AppIcon.ico" />（供 MainWindow.xaml.cs 的
      AppWindow.SetIcon("Assets/AppIcon.ico") 在运行期设置窗口图标），**没有** <ApplicationIcon>，
      于是 DelayStart.exe 自带的是 .NET 默认图标 —— 开始菜单 / 桌面快捷方式、任务栏、
      Alt-Tab、「应用和功能」里的卸载图标全是通用空白图标（用户回报的"缺少桌面图片"）。
      ⚠️ 与 <Content> 是两回事：Content 管"文件随程序发布"，ApplicationIcon 管"图标写进 exe 资源"。
      两者都要有。
    -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <!--
      ★ unpackaged（D22）：不走 MSIX 打包，直接产出可执行的 exe。
      模板生成的是 MSIX 打包工程，这两行是"转 unpackaged"的核心；配套还要删掉
      EnableMsixTooling / PublishProfile / MSIX ProjectCapability / WinApp 包引用。
      详见 docs/build-and-test.md 2.1 的改造清单。
    -->
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      ★ R9 已实测通过（2026-09-19，Phase 0 出口条件）：
      在 VS 之外双击 Release 产物，UAC 提权弹窗正常弹出 —— 说明在本机的
      Windows App SDK 1.8 + .NET 10 组合下，app.manifest 的
      requestedExecutionLevel **没有**被 WindowsAppSDKSelfContained 忽略，取值保持 true。
      （若日后升版 Windows App SDK 出现 R9 回归，降级路径是改 false 走框架依赖，
        由 Inno 安装器代部署 Windows App Runtime。见 docs/architecture.md 第九节 R9。）
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!--
      ★ D32：接管 WinUI 自动生成的 Main。
      XamlCompiler 默认生成一个 Program.Main（[STAThread] + ComWrappers 初始化 + Application.Start）。
      我们需要在初始化 XAML **之前**先判命令行：命中 headless 子命令就直接执行完退出，
      不创建窗口、不初始化 WinUI。关闭生成后由 Program.cs 提供语义等价的入口。
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- [LibraryImport] 的硬要求（build-and-test.md 坑 9），当前只有 AttachConsole 一处用到。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 依赖方向：App → Management → Core（architecture.md 1.2）。
         Scheduler 绝不出现于此，硬边界。 -->
    <ProjectReference Include="..\DelayStart.Core\DelayStart.Core.csproj" />
    <ProjectReference Include="..\DelayStart.Management\DelayStart.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    包引用由 Directory.Packages.props（CPM）统一给版本，此处不写 Version。
    模板原本还引用了 Microsoft.Windows.SDK.BuildTools.WinApp —— 它是为
    "打包应用的 dotnet run" 服务的（winapp CLI），unpackaged 用不上，已移除。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!--
    D35：MVVM 源生成器 + 官方 DI 容器。
    CommunityToolkit.Mvvm 是 architecture.md 5.2 与 coding-standards.md 12 指定的
    [ObservableProperty] / [RelayCommand] 实现；两者都只服务管理端 —— 调度端绝不引用
    本项目的任何包（它只引用 Core，见 architecture.md 1.2）。
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- PowerToys 同款设置卡片（UI v2.2，D1 批复 A）。 -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <!--
    ★ dev 布局下计划任务指向 App bin 里的调度器 exe（PathService.SchedulerExecutablePath =
    AppContext.BaseDirectory + "DelayStart.Scheduler.exe"）。**只有** Scheduler 的
    NativeAOT publish 单文件 exe 是可直接运行的形态 —— 普通引用拷贝过来的是 AppHost +
    托管 dll，runtimeconfig 声明 includedFrameworks 却没有随附运行时文件，一启动就弹
    "必须安装 .NET Desktop Runtime"（2026-09-20 真机踩坑）。
    所以这里在 App 构建后把 publish 产物同步进来；还没 publish 过就只警告不失败
    （正式安装布局由 Inno Setup 部署 publish 产物，不依赖本 target）。
  -->
  <Target Name="CopySchedulerPublishOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_SchedulerPublishExe>$(MSBuildThisFileDirectory)..\DelayStart.Scheduler\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\publish\DelayStart.Scheduler.exe</_SchedulerPublishExe>
    </PropertyGroup>
    <Copy
      SourceFiles="$(_SchedulerPublishExe)"
      DestinationFiles="$(OutDir)DelayStart.Scheduler.exe"
      Condition="Exists($(_SchedulerPublishExe))" />
    <Message
      Text="DelayStart.Scheduler 尚未 publish（缺少 $(_SchedulerPublishExe)），App bin 里的调度器 exe 可能不可运行 —— 先跑 dotnet publish src/DelayStart.Scheduler"
      Condition="!Exists($(_SchedulerPublishExe))"
      Importance="high" />
  </Target>

  <!--
    🔴 D61（2026-09-21 真机实测）：**publish 输出缺 XAML 产物与资源包**。

    背景：unpackaged 转换时按官方改造清单删掉了 <EnableMsixTooling>true</EnableMsixTooling>
    （见 docs/build-and-test.md 2.1），而 XBF / PRI / Content 资源原本是靠 MSIX 工具链
    进 publish 清单的。结果这些东西只落在 build 输出（bin），publish 目录一个都没有。

    实测证据（Compare-Object bin\...\win-x64 与 artifacts\publish\win-x64\full，
    按 .pdb/.xml 过滤后 11 项差异，全部是 App 自己的资源）：
      App.xbf · MainWindow.xbf · Dialogs\DelayEditorDialog.xbf · Views\*.xbf（8 个）
      DelayStart.pri · Assets\AppIcon.ico

    症状：装出来的程序一启动就在 Microsoft.UI.Xaml.dll 里 0xc000027b（内部 E_FAIL）
    秒崩，窗口完全不出现（事件日志 Application Error 1000 + WER APPCRASH 1000/组合
    combase.dll 0x80004005）。而**同一份产物在 bin 里双击完全正常** —— R9 与历次真机
    验收都是在 bin 目录做的，所以这个缺口一直没暴露。

    🔴 不要改用 <EnableMsixTooling>true</EnableMsixTooling> 来"修"：那会把整套 MSIX
    打包工具链拉回来（还牵连已移除的 Microsoft.Windows.SDK.BuildTools.WinApp），
    与 D22「不做 MSIX」直接冲突。这里只把缺的文件显式挂到 publish 落盘阶段。

    ⚠️ 用 AfterTargets="Publish" + Copy 而不是往 ResolvedFileToPublish 里塞条目：
    publish 条目收集由 SDK 内部目标决定，而本 target 的职责单一 —— "确保这些文件
    出现在 publish 目录"，落盘最直接也最好验证。
  -->
  <Target Name="CopyWinUIResourcesToPublishDir" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <!-- XBF：XAML 编译产物，按 XAML 的目录结构分层（根 / Views\ / Dialogs\）。
           ⚠️ 用 ** 通配而不是逐个列文件 —— 以后加页面/对话框不用回来改这里。 -->
      <_WinUIXbfToPublish Include="$(TargetDir)**\*.xbf" />
      <!-- 资源包：MRT Core 对非打包应用按「主模块名.pri」查找（bin 里就是 DelayStart.pri）。
           ⚠️ 不要改名成 resources.pri —— 那是打包应用的约定，bin 里能跑通靠的就是这个名字。 -->
      <_WinUIXbfToPublish Include="$(TargetDir)$(AssemblyName).pri"
                          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
      <!-- Content 资源：窗口图标（MainWindow.xaml.cs 的 AppWindow.SetIcon("Assets/AppIcon.ico")） -->
      <_WinUIAppAssetsToPublish Include="$(TargetDir)Assets\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIXbfToPublish)"
      DestinationFiles="@(_WinUIXbfToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_WinUIAppAssetsToPublish)"
      DestinationFiles="@(_WinUIAppAssetsToPublish->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <!-- ⚠️ 这里刻意不写 @(...->'%(Filename)') 之类的项变换：Message 的 Text 里
         混用项变换容易踩 MSB4095（未指定项名称），静态文案足够说明问题。 -->
    <Message
      Text="已补充 publish 的 XAML 产物与资源包（D61）：*.xbf + $(AssemblyName).pri + Assets\*"
      Importance="normal" />
  </Target>

</Project>
