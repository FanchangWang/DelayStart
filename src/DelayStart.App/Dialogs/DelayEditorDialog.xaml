<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="DelayStart.App.Dialogs.DelayEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="using:DelayStart.App.Controls"
    mc:Ignorable="d"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- 2026-09-20 批复 4：解除 ContentDialog 默认 540px 最大宽度限制；840 过宽回调到 700。 -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    </ContentDialog.Resources>

    <!--
        延时配置编辑器（docs/design-spec.md 三之二）。
        4 个编号步骤块 + 底部活摘要，4 种进入方式共用这一个弹窗：

          加入系统项 —— 目标程序只读（① 显示只读卡片）
          编辑系统项 —— 目标程序只读
          编辑手动项 —— 目标程序可更换（① 显示选择区 + 名称 + 工作目录）
          手动添加   —— 目标程序可选择

        分叉的唯一依据是"这条记录有没有系统来源"，由 code-behind 按形态切 ① 里的面板。
        🔴 根节点是 Grid：自定义延时提交前的二次确认面板（ConfirmOverlay）要覆盖整个内容区
        （ContentDialog 之上不能叠第二个 ContentDialog，2026-09-19 用户批复 6）。
        二轮 bug 批复 3/4/5：延时胶囊与身份胶囊统一 8 间距；胶囊宽度自适应内容；
        校验提示（ValidationBar）放在**内容区顶部**——弹窗内容超高时不滚动也能看到。
    -->
    <Grid>
        <ScrollViewer
            MaxHeight="520"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!-- 2026-09-20 批复 4：去掉固定 Width，跟随 ContentDialogMaxWidth=700 自适应。 -->
            <StackPanel Spacing="14">

            <!-- 校验提示：置顶（二轮 bug 批复 5）—— 内容区滚动位置在哪儿都看得见 -->
            <InfoBar
                x:Name="ValidationBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <TextBlock
                x:Name="SubtitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <!-- ① 目标程序 -->
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="① 目标程序" />
                <TextBlock
                    x:Name="TargetHintText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- 形态 A：由系统自启动项绑定，不可更改 -->
                <Border
                    x:Name="ReadOnlyTargetBorder"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TargetNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TargetPathText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TargetSourceText"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- 形态 B-1：还没选程序（拖放走经典 WM_DROPFILES —— XAML 拖放在提权进程里
                     被 UIPI 拦死，批复 4 改造后由 FileDropReceiver 广播路径进来） -->
                <Border
                    x:Name="PickEmptyBorder"
                    Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Button
                        x:Name="PickFileButton"
                        Padding="16,18"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="OnPickFile"
                        Style="{StaticResource TextBlockButtonStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center" Text="拖入文件，或点击选择程序" />
                            <TextBlock
                                x:Name="PickFileTypesText"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="支持 .exe / .lnk / .bat / .cmd / .msi" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 形态 B-2：已选程序（同样接受拖放更换） -->
                <Border
                    x:Name="PickFilledBorder"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="PickedNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="PickedPathText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnPickFile"
                            Content="更换" />
                    </Grid>
                </Border>

                <TextBox
                    x:Name="NameBox"
                    Header="显示名称 — 自动取自文件名，可改"
                    PlaceholderText="例如：微信" />

                <TextBox
                    x:Name="ArgumentsBox"
                    Header="命令行参数 — 可选"
                    PlaceholderText="留空则不附加参数" />

                <TextBox
                    x:Name="WorkingDirBox"
                    Header="工作目录 — 可选"
                    PlaceholderText="留空则使用程序所在目录" />
            </StackPanel>

            <!-- ② 延时时间（胶囊快选：WrapGrid 换行 + 按内容自适应宽度，间距 8） -->
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="② 延时时间" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="以登录时刻为起点的绝对时间点；同一时间点的多个程序几乎同时启动" />

                <!-- 胶囊由 code-behind 填充（选中 = 当前延时；自定义值不在预设里时全部弹起）。
                     🔴 Round H 批复 5：横向 StackPanel 超宽直接被裁掉看不到 → 换自绘 WrapPanel
                     （按内容测量 + 自动换行，宽度仍自适应）。 -->
                <ItemsControl x:Name="DelayChoices">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:WrapPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        x:Name="CustomDelayBox"
                        Width="140"
                        Header="自定义（秒）"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnCustomDelayChanged" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="手动输入的自定义值提交前需要确认" />
                </StackPanel>
            </StackPanel>

            <!-- ③ 启动身份（一行两个胶囊，间距与延时胶囊一致 = 8） -->
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="③ 启动身份" />
                <StackPanel
                    x:Name="IdentityChoices"
                    Orientation="Horizontal"
                    Spacing="8" />
                <TextBlock
                    x:Name="IdentityHintText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- ④ 接管对象 / 系统影响 -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="ImpactHeaderText" FontWeight="SemiBold" Text="④ 接管对象" />
                <Border
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="条目类型" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoTypeText" TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="写入位置" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="InfoWriteText"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="系统影响" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoImpactText" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 底部活摘要（设计稿要求：随延时 / 身份选择实时更新） -->
            <TextBlock
                x:Name="SummaryText"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

        </StackPanel>
        </ScrollViewer>

        <!-- 二次确认覆盖层（用户批复 6：手动编辑自定义延时后提交需确认） -->
        <Border
            x:Name="ConfirmOverlay"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Visibility="Collapsed">
            <StackPanel Spacing="14" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="确认自定义延时" />
                <TextBlock
                    x:Name="ConfirmText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnConfirmDelayRejected" Content="返回修改" />
                    <Button
                        Click="OnConfirmDelayAccepted"
                        Content="确认使用"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
