<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DelayStart.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DelayStart.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DelayStart"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        UI v2（PowerToys 风格，docs/ui-mockup-v2.html）：
        ① 标题栏不带应用图标，折叠按钮由 TitleBar 的 pane toggle 承担；
        ② 内容区与标题栏 / 菜单同背景（Mica 通透），页面内不铺底色；
        ③ 底部调度任务状态条已移除 —— 任务状态改由总览页的开关承担。
        ④ 自启动项 / 系统启动项改为带子项的父级菜单（来源与分区即入口）。

        🔴 本文件里**不要写 <NavigationViewSeparator />**：WinAppSDK 1.8.260224000
        的 XamlCompiler pass-1 遇到它会静默崩溃（退出码 1、零错误输出）。
        分隔线由 code-behind 在运行时插入（见 MainWindow.xaml.cs 的 InsertSeparatorAfter）。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="DelayStart"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <!--
                问题1（2026-09-19）：内容区与标题栏 / 菜单颜色不同 ——
                NavigationView 默认给内容区铺 LayerFillColorDefault 半透明层，
                在 Mica 背景上会显得比窗格亮。置为 Transparent 让 Mica 一贯到底。
            -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="总览" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="延时启动" Tag="delay">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    自启动项：四个来源即四个入口（UI v2），进入各自的来源页。
                    🔴 父级菜单 SelectsOnInvoked=False（用户反馈 5）：点击只展开 / 折叠，
                    不切换页面 —— 自启动项没有总页面。
                -->
                <NavigationViewItem
                    Content="自启动项"
                    SelectsOnInvoked="False"
                    Tag="items">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="注册表" Tag="items-registry" />
                        <NavigationViewItem Content="启动文件夹" Tag="items-folder" />
                        <NavigationViewItem Content="计划任务" Tag="items-task" />
                        <NavigationViewItem Content="UWP Apps" Tag="items-uwp" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- 系统启动项：四个分区即四个入口（全部只读），父级同样只展开不切页 -->
                <NavigationViewItem
                    Content="系统启动项"
                    SelectsOnInvoked="False"
                    Tag="system">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="服务" Tag="sys-services" />
                        <NavigationViewItem Content="驱动" Tag="sys-drivers" />
                        <NavigationViewItem Content="Winlogon" Tag="sys-winlogon" />
                        <NavigationViewItem Content="组策略" Tag="sys-gpo" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem Content="运行日志" Tag="runs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
