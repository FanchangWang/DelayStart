<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DelayStart.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DelayStart.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="延时启动管理器"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="延时启动管理器"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
          导航结构与页面清单见 docs/architecture.md 1.4 与 docs/design-spec.md：
          6 个顶层模块（总览 / 自启动项 / 延时启动 / 系统启动项 / 运行日志 / 设置），
          其中「自启动项」下再按来源分子项。

          Phase 0 此处**刻意留空**：
            · 模板自带的 Home / About 与预定页集不符，已随 Pages/ 一并删除（D25 = A）
            · 不预置占位导航项 —— 点了没反应的死链比没有导航更糟
            · IsSettingsVisible=False 是有意的：本产品的「设置」是 6 个顶层模块之一，
              不用 NavigationView 内置的那个设置项
          导航项与页面在 Phase 3 落地。
        -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False">
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
