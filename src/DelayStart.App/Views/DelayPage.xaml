<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.DelayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <!--
        「延时启动」页（docs/design.md 7.5）。
        ⚠️ 本页**只有列表**一种视图 —— 时间轴视图已按 D37 = B 整体删除。
        列：顺序 / 图标 / 程序 / 延时 / 身份 / 开关 / ↑↓ / 操作。

        2026-09-20 用户批复：
          · 列表按**延时时间分组**，每组上方给一个子标题（= 延时本身）；
          · 版式 = 子标题 → 边框 → 该组的列表，**边框按组**（D52 本轮修正）。
            此前是整个列表共用一张大卡片（所有组都在里面），改成每组一张卡片后
            "这几条属于同一组"这件事由边框直接说清，边框样式沿用卡片默认画刷/圆角。
        实现上不用 ListView，而是 ItemsControl 套 ItemsControl：
          - 表头跟组走：每组「子标题 → 表头 → 卡片」（2026-09-21 二轮批复，
            列宽与行模板逐列相同）；
          - 外层按组（ViewModel.Groups），子标题 = 「登录后 30 秒 · 3 项」；
          - 内层按行，行模板与改造前完全一致。
        组的意义见 ViewModels/DelayGroup 的备注：同延时的条目本来就会一起启停，
        而 ↑↓ 顺来就只在这一组内生效（FR-4.7）。

        2026-09-22（D81）：**失效条目并入本页**（不再有独立的「失效条目」页面）。
        失效行只改两处，其余列保持原样：
          · 「启用」列不显示开关，改显示「已失效」文字（它根本启动不了，开关没有意义）；
          · 「操作」列换成「删除」/「转为手动」—— 目标程序已不存在时只剩「删除」。
        显隐由 DelayRow 的 IsNormal / IsStale / CanConvertToManual 三个 bool 直接驱动
        （x:Bind 支持 bool → Visibility 的隐式转换，不必再挂转换器）。
    -->
    <Page.Resources>
        <!-- 行内小按钮（↑↓ / 编辑 / 移出延时 / 删除 / 转为手动）：比默认按钮瘦一圈，八列才排得下 -->
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头（原常驻 InfoBar「延时不是累加」的要点并入这句描述，2026-09-21 批复：
             顶部不再摆常驻提示框） -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="延时启动" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Text="延时从登录时刻起算、不是累加；同一延时的条目按列表顺序依次启动。若 B 依赖 A 先就绪，请给 B 设置更大的延时。" />

            <!-- 本次登录预览（FR-15.23）：进计划几项 / 跳过几项。
                 行内标记回答"这一行怎么了"，这一行回答"整体今天会发生什么"。 -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CycleSummary, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasCycleSummary, Mode=OneWay}" />
        </StackPanel>

        <!-- 顶部两条横幅共用一个 StackPanel：它们可能同时出现（配置坏了 + 次年数据没到），
             各自占一格会互相压住 —— 这一行的高度是 Auto。 -->
        <StackPanel Grid.Row="1" Spacing="8">
            <!-- 配置不可用 / 扫描失败 -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Warning"
                Title="提示" />

            <!-- 次年节假日数据的到期提醒（§6.5）：11 月 1 日起、次年无数据、且有条目在用法定两档。
                 Informational 而不是 Warning —— 它不是故障，是"官方数据还没公布"。 -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasHolidayNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.HolidayNoticeText, Mode=OneWay}"
                Severity="Informational"
                Title="节假日数据待更新" />
        </StackPanel>

        <!-- 工具栏（本批：刷新 + 手动添加） -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar
                Grid.Column="0"
                IsIndeterminate="True"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Click="OnAddManualRequested"
                Content="手动添加" />

            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="刷新" />
        </Grid>

        <!-- 列表区：每组「子标题 → 表头 → 边框卡片」（2026-09-21 二轮批复：表头跟组走，
             子标题在表头上方）。表头左内边距 28 = **内层卡片 Border 8** + 行 Grid 20
             —— 组本身没有卡片（组是 StackPanel），别在这条公式里塞"组卡"（批复 26 校正）；
             列标题一律左对齐（批复 25）。
             ⚠️ 本区必须落在 * 行上（滚动 bug 教训）：放 Auto 行时 ScrollViewer 拿不到
             高度约束，会整体撑开到内容高度，滚动条永不出现（2026-09-21 实测）。 -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DelayGroup">
                            <StackPanel Margin="0,0,0,14" Spacing="6">
                                <!-- 子标题：延时本身 + 组内条目数 -->
                                <StackPanel
                                    Margin="4,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind CountText}" />
                                </StackPanel>

                                <!-- 表头：跟组走（每列表头，子标题在其上方）。
                                     列宽与行模板逐列相同；左内边距 28 = 卡片 8 + 行 20，
                                     与行内容逐列对齐。
                                     列标题**一律左对齐**（2026-09-23 批复 25）：TextBlock
                                     默认 Stretch + 左对齐，所以下面不写对齐属性。 -->
                                <Grid Padding="28,0,28,2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="#" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="程序" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="延时" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="身份" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="启用" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="顺序" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="操作" />
                                </Grid>

                                <!-- 边框：本组条目（画刷/圆角沿用卡片默认） -->
                                <Border
                                    Padding="8,4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <ItemsControl ItemsSource="{x:Bind Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DelayRow">
                                                <Grid Padding="20,10,20,10" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="170" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 顺序：与调度端的发起顺序一致（组内 ↑↓ 局部更新时联动） -->
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind OrderText, Mode=OneWay}" />

                                                    <!-- 图标（D30）：64px 源显示为 32 DIP，200% DPI 下不糊；取不到时显示占位符 -->
                                                    <Grid
                                                        Grid.Column="1"
                                                        Height="32"
                                                        VerticalAlignment="Center">
                                                        <!-- 行对象不可变，图标在构造时定型：OneTime 即可
                                                             （OneWay 在非 INPC 行上是编译错误 WMC1506） -->
                                                        <Image
                                                            Source="{x:Bind Icon}"
                                                            Stretch="Uniform"
                                                            Visibility="{x:Bind HasIcon}" />
                                                        <FontIcon
                                                            FontSize="20"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE7C3;"
                                                            Visibility="{x:Bind HasNoIcon}" />
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <!--
                                                                周期徽标（FR-15.21）：**所有**周期都显示，包括内置的「每天」。
                                                                悬停给"包含哪些天"或"随当年放假安排变动"。
                                                            -->
                                                            <Border
                                                                Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                ToolTipService.ToolTip="{x:Bind CycleToolTip}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind CycleText}" />
                                                            </Border>

                                                            <!--
                                                                今日跳过徽标（FR-15.22 / 2026-09-23 批复 17）：
                                                                与周期徽标**同款**的圆角边框，只是文字换成"今天不启动"
                                                                并用警示色 —— 原先的"红圈 + 斜杠 + 今"三件套用户反馈不好看。
                                                                悬停仍给"今天为什么不启动"的完整理由。
                                                                🔴 整行**不置灰** —— 变淡是「启用 = 关」的视觉语言，
                                                                两个语义不许共用同一个表达。
                                                            -->
                                                            <Border
                                                                Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                ToolTipService.ToolTip="{x:Bind SkipToolTip}"
                                                                Visibility="{x:Bind IsSkippedToday}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="今天不启动" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind CommandLine}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind SourceText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- 批复 7：延时、身份拆成两列 -->
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind DelayText}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind IdentityText}" />

                                                    <!-- 条目级开关（FR-4.6）：只影响本次登录是否启动它，不动系统。
                                                         OneWay：局部更新后由 VM 推回真实状态（WMC1506 之外，
                                                         DelayRow 现在是 ObservableObject，OneWay 合法）。
                                                         失效行不显示开关（见下方的「已失效」文字）—— 两者占同一格，
                                                         同一时刻只有一个可见。 -->
                                                    <ToggleSwitch
                                                        Grid.Column="5"
                                                        MinWidth="0"
                                                        VerticalAlignment="Center"
                                                        IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="OnEnabledToggled"
                                                        Visibility="{x:Bind IsNormal, Mode=OneTime}" />

                                                    <!-- 失效标注（D81）：接管清单里系统项已被删除（孤儿），
                                                         或目标程序已不存在。悬停给出具体原因。 -->
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="已失效"
                                                        ToolTipService.ToolTip="{x:Bind StaleReason}"
                                                        Visibility="{x:Bind IsStale, Mode=OneTime}" />

                                                    <!-- ↑↓：仅在同延时组内有效（FR-4.7），端点由服务层返回 false 时无效果 -->
                                                    <StackPanel
                                                        Grid.Column="6"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <Button
                                                            Click="OnMoveUp"
                                                            Content="↑"
                                                            Style="{StaticResource RowButtonStyle}"
                                                            ToolTipService.ToolTip="上移（同一延时内）" />
                                                        <Button
                                                            Click="OnMoveDown"
                                                            Content="↓"
                                                            Style="{StaticResource RowButtonStyle}"
                                                            ToolTipService.ToolTip="下移（同一延时内）" />
                                                    </StackPanel>

                                                    <!-- 正常条目：编辑 / 移出延时 -->
                                                    <StackPanel
                                                        Grid.Column="7"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Visibility="{x:Bind IsNormal, Mode=OneTime}">
                                                        <Button
                                                            Click="OnEditRequested"
                                                            Content="编辑"
                                                            Style="{StaticResource RowButtonStyle}" />

                                                        <!-- 移出延时：这是「全部可逆」的出口，任何条目都必须能走（FR-2.7 / D17） -->
                                                        <Button
                                                            Click="OnRemoveRequested"
                                                            Content="移出延时"
                                                            Style="{StaticResource RowButtonStyle}" />
                                                    </StackPanel>

                                                    <!-- 失效条目（D81）：删除 / 转为手动。
                                                         🔴 两者不能互相替代：删除只动配置；
                                                         「转为手动」留着条目、但要求目标程序还在。 -->
                                                    <StackPanel
                                                        Grid.Column="7"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Visibility="{x:Bind IsStale, Mode=OneTime}">
                                                        <Button
                                                            Click="OnDeleteRequested"
                                                            Content="删除"
                                                            Style="{StaticResource RowButtonStyle}"
                                                            ToolTipService.ToolTip="从延时列表里删除这条记录（不动系统任何设置）" />
                                                        <Button
                                                            Click="OnConvertRequested"
                                                            Content="转为手动"
                                                            Style="{StaticResource RowButtonStyle}"
                                                            ToolTipService.ToolTip="脱离系统来源，变成一个手动添加的条目"
                                                            Visibility="{x:Bind CanConvertToManual, Mode=OneTime}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        <!-- 空状态（docs/design.md 7.5） -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="还没有延时启动项" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="到「自启动项」页找到想延后的程序，点击「加入延时」；或者直接手动添加一个程序。" />
        </StackPanel>
    </Grid>
</Page>
