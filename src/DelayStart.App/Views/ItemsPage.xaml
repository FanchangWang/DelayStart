<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <!--
        「自启动项」来源页（UI v2：注册表 / 启动文件夹 / 计划任务 / UWP Apps 四个入口共用本页，
        由导航标签决定显示哪个来源，docs/ui-mockup-v2.html）。
        列表读自扫描缓存（bug#7）；行操作（bug#3/#4/#6）：查看 / 接管 / 移出延时 / 禁用 / 启用 / 编辑。
        二轮 bug 批复 3/4：列宽全部固定（表头与行严格同列）；行内不再重复显示来源文字。
    -->
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StatusKindToBrushConverter x:Key="StatusBrush" />

        <Style x:Key="ItemRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" Text="自启动项" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        </StackPanel>

        <!-- 工具栏：状态筛选 + 排序 + 搜索 + 刷新本页（筛选只过滤显示，不触发重扫） -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                MinWidth="120"
                VerticalAlignment="Center"
                SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}">
                <ComboBoxItem Content="全部状态" />
                <ComboBoxItem Content="已启用" />
                <ComboBoxItem Content="已禁用" />
                <ComboBoxItem Content="已接管" />
            </ComboBox>

            <ComboBox
                Grid.Column="1"
                MinWidth="110"
                VerticalAlignment="Center"
                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <ComboBoxItem Content="按名称" />
                <ComboBoxItem Content="按状态" />
            </ComboBox>

            <ProgressBar
                Grid.Column="2"
                IsIndeterminate="True"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBox
                Grid.Column="3"
                MinWidth="220"
                VerticalAlignment="Center"
                PlaceholderText="搜索名称、命令或位置"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="4"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="刷新本页" />
        </Grid>

        <!-- 来源级失败提示（FR-1.4） -->
        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.FailureText, Mode=OneWay}"
            Severity="Warning"
            Title="部分来源扫描失败" />

        <!-- 列表：绑定筛选后的可见集合（D2 批复 A：列表包进卡片） -->
        <Border
            Grid.Row="3"
            Padding="8,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    表头：列宽与行模板**逐列相同**（40 / * / 100 / 300）——
                    之前的 Auto 列让表头与行按各自内容测宽，列位置错开（二轮 bug 批复 3）。
                -->
                <Grid Grid.Row="0" Padding="28,8,28,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="程序" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="状态" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="操作" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource ItemRowStyle}"
                    ItemsSource="{x:Bind ViewModel.FilteredRows}"
                    SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupEntryRow">
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标（D30）：行对象不可变，OneTime 绑定（WMC1506） -->
                            <Grid
                                Grid.Column="0"
                                Height="32"
                                VerticalAlignment="Center">
                                <Image
                                    Source="{x:Bind Icon}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasIcon}" />
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE7C3;"
                                    Visibility="{x:Bind HasNoIcon}" />
                            </Grid>

                            <!-- 名称 + 命令行；完整位置（注册表键 / 文件路径）放 Tooltip，不在行里重复占行（二轮 bug 批复 4） -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2"
                                ToolTipService.ToolTip="{x:Bind LocationText}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind CommandLine}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 状态徽标（D1）：药丸样式，配色按 StatusKind 分档 -->
                            <Border
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{x:Bind StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=bg, Mode=OneTime}"
                                CornerRadius="4"
                                Padding="8,3">
                                <TextBlock
                                    Foreground="{x:Bind StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=fg, Mode=OneTime}"
                                    FontSize="12"
                                    Text="{x:Bind StatusText, Mode=OneTime}" />
                            </Border>

                            <!-- 行操作（UI v2）：按状态显隐 —— 查看 / 接管 / 移出延时 / 禁用 / 启用 / 编辑 -->
                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Click="OnViewRequested"
                                    Content="查看" />
                                <Button
                                    Click="OnDelayRequested"
                                    Content="加入延时"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind CanTakeOver, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                <Button
                                    Click="OnReleaseRequested"
                                    Content="移出延时"
                                    Visibility="{x:Bind CanRelease, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                <Button
                                    Click="OnDisableRequested"
                                    Content="禁用"
                                    Visibility="{x:Bind CanDisable, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                <Button
                                    Click="OnEnableRequested"
                                    Content="启用"
                                    Visibility="{x:Bind CanEnable, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                <Button
                                    Click="OnEditRequested"
                                    Content="编辑"
                                    Visibility="{x:Bind CanEdit, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 空状态：区分"系统里没有"与"被筛光了" -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind ViewModel.FilteredEmpty, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
