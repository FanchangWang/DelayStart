<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <!--
        「自启动项」页（docs/design-spec.md 页面 2）。
        Phase 3 本批只落地「页头 + 常驻说明条 + 失败提示 + 刷新 + 列表」，
        搜索 / 筛选 / 排序 / 状态徽标配色 / 行内操作菜单 / 批量模式在后续批次补。
    -->
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ItemRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="自启动项" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        </StackPanel>

        <!-- 常驻说明条：必须解释"软禁用"与"手动条目不在本页"两件事（design-spec 页面 2） -->
        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="不会删除注册表值，也不会移动文件，随时可以还原成系统默认状态。本页只列出系统里已经存在的自启动项；手动添加的程序属于调度任务而非系统自启动项，只出现在「延时启动」页。"
            Severity="Informational"
            Title="这里的「禁用」与「移出延时」都是软禁用" />

        <!-- 来源级失败提示（FR-1.4）：必须说清"列表可能不完整" -->
        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.FailureText, Mode=OneWay}"
            Severity="Warning"
            Title="部分来源扫描失败" />

        <!-- 工具栏（本批只有刷新；搜索 / 筛选 / 排序随后补） -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar
                Grid.Column="0"
                IsIndeterminate="True"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="刷新扫描" />
        </Grid>

        <!-- 列表 -->
        <ListView
            Grid.Row="4"
            ItemContainerStyle="{StaticResource ItemRowStyle}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupEntryRow">
                    <Grid Padding="12,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind CommandLine}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LocationText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind StatusText}" />

                        <!--
                            「延时启动」入口只在可接管时可见（受保护 / 已失效 / 已接管的条目不显示），
                            判据来自模型的 CanTakeOver，界面不复制一份。
                        -->
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnDelayRequested"
                            Content="延时启动"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态；有数据时整块折叠 -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="此位置没有自启动项" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="点「刷新扫描」重新检查全部来源" />
        </StackPanel>
    </Grid>
</Page>
