<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <!--
        「自启动项」页（docs/design-spec.md 页面 2）。
        Phase 3 本批只落地「页头 + 常驻说明条 + 失败提示 + 刷新 + 列表」，
        搜索 / 筛选 / 排序 / 状态徽标配色 / 行内操作菜单 / 批量模式在后续批次补。
    -->
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StatusKindToBrushConverter x:Key="StatusBrush" />

        <Style x:Key="ItemRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- 来源分段 Tab 的药丸按钮（D1）：选中态由 code-behind 维护互斥 -->
        <Style x:Key="SourceTabStyle" TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="自启动项" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        </StackPanel>

        <!-- 常驻说明条：必须解释"软禁用"与"手动条目不在本页"两件事（design-spec 页面 2） -->
        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="不会删除注册表值，也不会移动文件，随时可以还原成系统默认状态。本页只列出系统里已经存在的自启动项；手动添加的程序属于调度任务而非系统自启动项，只出现在「延时启动」页。"
            Severity="Informational"
            Title="这里的「禁用」与「移出延时」都是软禁用" />

        <!-- 来源级失败提示（FR-1.4）：必须说清"列表可能不完整" -->
        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.FailureText, Mode=OneWay}"
            Severity="Warning"
            Title="部分来源扫描失败" />

        <!-- 工具栏：来源分段 Tab + 状态筛选 + 排序 + 搜索 + 刷新（筛选只过滤显示，不触发重扫） -->
        <StackPanel Grid.Row="3" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    Click="OnSourceTabClicked"
                    Content="全部"
                    IsChecked="True"
                    Style="{StaticResource SourceTabStyle}"
                    Tag="0" />
                <ToggleButton
                    Click="OnSourceTabClicked"
                    Content="注册表"
                    Style="{StaticResource SourceTabStyle}"
                    Tag="1" />
                <ToggleButton
                    Click="OnSourceTabClicked"
                    Content="启动文件夹"
                    Style="{StaticResource SourceTabStyle}"
                    Tag="2" />
                <ToggleButton
                    Click="OnSourceTabClicked"
                    Content="计划任务"
                    Style="{StaticResource SourceTabStyle}"
                    Tag="3" />
                <ToggleButton
                    Click="OnSourceTabClicked"
                    Content="UWP"
                    Style="{StaticResource SourceTabStyle}"
                    Tag="4" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    Grid.Column="2"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <ComboBox
                    Grid.Column="0"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="全部状态" />
                    <ComboBoxItem Content="已启用" />
                    <ComboBoxItem Content="已禁用" />
                    <ComboBoxItem Content="已接管" />
                </ComboBox>

                <ComboBox
                    Grid.Column="1"
                    MinWidth="110"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="按来源" />
                    <ComboBoxItem Content="按名称" />
                    <ComboBoxItem Content="按状态" />
                </ComboBox>

                <TextBox
                    Grid.Column="3"
                    MinWidth="220"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索名称、命令或位置"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="刷新扫描" />
            </Grid>
        </StackPanel>

        <!-- 列表：绑定筛选后的可见集合 -->
        <ListView
            Grid.Row="4"
            ItemContainerStyle="{StaticResource ItemRowStyle}"
            ItemsSource="{x:Bind ViewModel.FilteredRows}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupEntryRow">
                    <Grid Padding="12,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 图标（D30）：64px 源显示为 32 DIP，200% DPI 下不糊；取不到时显示占位符 -->
                        <Grid
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center">
                            <!-- 行对象不可变，图标在构造时定型：OneTime 即可（OneWay 在非 INPC 行上是编译错误 WMC1506） -->
                            <Image
                                Source="{x:Bind Icon}"
                                Stretch="Uniform"
                                Visibility="{x:Bind HasIcon}" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE7C3;"
                                Visibility="{x:Bind HasNoIcon}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind CommandLine}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LocationText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 状态徽标（D1）：药丸样式，配色经 StatusBrush 转换器按 StatusKind 分档 -->
                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{x:Bind StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=bg, Mode=OneTime}"
                            CornerRadius="4"
                            Padding="8,3">
                            <TextBlock
                                Foreground="{x:Bind StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=fg, Mode=OneTime}"
                                FontSize="12"
                                Text="{x:Bind StatusText, Mode=OneTime}" />
                        </Border>

                        <!--
                            「延时启动」入口只在可接管时可见（受保护 / 已失效 / 已接管的条目不显示），
                            判据来自模型的 CanTakeOver，界面不复制一份。
                        -->
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Click="OnDelayRequested"
                            Content="延时启动"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态：区分"系统里没有"与"被筛光了"，文案与显隐都来自 ViewModel -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind ViewModel.FilteredEmpty, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
