<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- 分节标题（参考 PowerToys 子标题字号，SubtitleTextBlockStyle 的 20px 太大） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 计数 chip：两排统一最小宽度 -->
        <Style x:Key="CountChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- chip 内容（数字 + 文字）整体居中 -->
        <Style x:Key="ChipContentStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- D117：卡片标题行（后台任务 / 最近记录两区的卡都长这样） -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- D117：卡片说明行（左侧第二行，最多两行的第二条） -->
        <Style
            x:Key="CardDescStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <!--
        「总览」页 UI v3（2026-09-21 批复）+ v4（D115）+ v5（D117，2026-09-24 批复）：
        ① 「最大延时」分节删除；顶部「上次运行有失败」InfoBar 删除 —— 失败由记录卡红字承担；
        ② 开机调度任务从开关改为**状态卡**（缺失自动补建，失败红字 +「重试创建」）；
        ③ D115：上次记录从逐条目小表换成汇总卡片；
        ④ D117：四张卡合并为两个分节 ——
           「后台任务」= 开机调度卡 + 自启动项守卫卡（左两行文字，右 = 状态 / 按钮 / 下拉）；
           「最近记录」= 调度卡 + 守卫卡（左 = 汇总 + 时间，右 = 直达链接；空态左两行提示，
           右侧链接保留）。各卡左侧最多两行文字；档位说明行与任务注册细节删除。
    -->
    <ScrollView>
        <StackPanel Padding="32,8,32,40" HorizontalAlignment="Stretch" MaxWidth="1000">

            <!-- 页头 -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="总览" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="延时启动的整体状态：条目分布、后台任务与最近一次调度、巡检的结果。" />
            </StackPanel>

            <!-- ── 延时启动 ── -->
            <TextBlock
                Margin="0,28,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="延时启动" />

            <!-- 延时区的 5 个 chip 都跳「延时启动」页 -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedManual, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="手动添加" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 后台任务（D117：原「开机调度任务」+「自启动项守卫」合并） ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="后台任务" />

            <!-- 调度卡 · 正常态：左两行（标题 + 说明），右 = 状态（2026-09-21 批复：缺失自动补建，
                 所以"已启用"是常态；失败态见下一张卡）。 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.TaskReady, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="开机调度" />
                        <TextBlock Style="{StaticResource CardDescStyle}" Text="每次登录后按延时计划自动启动接管的条目。" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="✓ 已启用" />
                </Grid>
            </Border>

            <!-- 调度卡 · 失败态：说明让位给失败原因，右侧红标 + 重试 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.TaskReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CardTitleStyle}"
                            Text="开机调度" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.TaskStatusDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="✕ 未就绪" />
                        <Button
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.EnsureTaskCommand, Mode=OneWay}"
                            Content="重试创建"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 守卫卡：左两行（标题 + 说明；说明在同步失败时让位给红字错误），右 = 重试 + 档位下拉。
                 回灌（LoadAsync 设 GuardSelectedIndex）会触发一次 SelectionChanged，
                 由 code-behind 的 _initialized 守卫挡掉，不会误落盘。 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="自启动项守卫" />
                        <!-- 🔴 两份互斥的 TextBlock（D42 教训）：非警示那份不显式设 Foreground。 -->
                        <TextBlock
                            Style="{StaticResource CardDescStyle}"
                            Text="应用重新打开自启动项时自动禁用；出现新增或失效条目时提醒。"
                            Visibility="{x:Bind ViewModel.GuardHasError, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.GuardError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.GuardHasError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryGuardCommand, Mode=OneWay}"
                            Content="重试"
                            Visibility="{x:Bind ViewModel.GuardHasError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <ComboBox
                            MinWidth="220"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.GuardOptions}"
                            SelectedIndex="{x:Bind ViewModel.GuardSelectedIndex, Mode=OneWay}"
                            SelectionChanged="OnGuardModeChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 系统自启动项 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="系统自启动项" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoRegistry" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoFolder" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoTask" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoUwp" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 最近记录（D117：原「上次开机调度」+「上次守卫巡检」合并。
                 卡片身份由右侧链接文字表达；空态 = 左两行提示，右侧链接保留 ——
                 点进去只是空列表页，不影响功能。） ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="最近记录" />

            <!-- 调度卡：左两行（结果口径 / 时间；含失败项或未正常完成时标红），右 = 直达调度日志 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 有记录：汇总 + 时间。🔴 汇总行是两份互斥的 TextBlock（D42 教训），
                         非警示那份不显式设 Foreground。 -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind ViewModel.RecentRunEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource CardTitleStyle}"
                            Text="{x:Bind ViewModel.RecentRunSummary, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.RecentRunHasFailure, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{x:Bind ViewModel.RecentRunHasFailure, Converter={StaticResource BoolToBrush}, Mode=OneWay}"
                            Style="{StaticResource CardTitleStyle}"
                            Text="{x:Bind ViewModel.RecentRunSummary, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.RecentRunHasFailure, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RecentRunTimeText, Mode=OneWay}" />
                    </StackPanel>
                    <!-- 无记录：提示两行 -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind ViewModel.RecentRunEmpty, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CardDescStyle}" Text="还没有调度记录" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="接管条目并重启后，启动结果会出现在这里。" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnGoRuns"
                        Content="查看调度日志 →" />
                </Grid>
            </Border>

            <!-- 守卫卡：左两行（巡检汇总 / 完成时间），右 = 直达守卫日志 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 有记录：汇总 + 时间 -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind ViewModel.RecentGuardEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource CardTitleStyle}"
                            Text="{x:Bind ViewModel.RecentGuardSummary, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RecentGuardTimeText, Mode=OneWay}" />
                    </StackPanel>
                    <!-- 无记录：提示两行 -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Visibility="{x:Bind ViewModel.RecentGuardEmpty, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CardDescStyle}" Text="还没有守卫巡检记录" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="守卫档位开启后，巡检结论会出现在这里。" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnGoGuardRuns"
                        Content="查看守卫日志 →" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollView>
</Page>
