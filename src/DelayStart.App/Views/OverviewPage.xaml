<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- 分节标题（批复 3：参考 PowerToys 子标题字号，SubtitleTextBlockStyle 的 20px 太大） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 计数 chip：两排统一最小宽度（批复 6） -->
        <Style x:Key="CountChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- chip 内容（数字 + 文字）整体居中（Round H 批复 6） -->
        <Style x:Key="ChipContentStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!--
        「总览」页 UI v2.2（PowerToys 分节卡片化，docs/ui-mockup-v2.html）。
        2026-09-20 Round H 批复：
        5 —— 根容器改 Stretch + MaxWidth=1000：内容少也撑满 1000，窗口不足 1000 自动收缩
             （HorizontalAlignment=Center 会收缩到内容宽度，各页宽窄不一，已修正；
             PowerToys 同款做法：PageStyle 的 MaxWidth=1000 挂在 Stretch 容器上）；
        6 —— chip 内两行文字各自 TextAlignment=Center（此前只居中整个内容块，
             数字与文字宽度不同时窄的一行仍贴左，看起来没变）；
        8 —— 页头标题居中。
    -->
    <ScrollView>
        <StackPanel Padding="32,8,32,40" HorizontalAlignment="Stretch" MaxWidth="1000">

            <!-- 页头（Round I 批复 5：标题在居中后的内容区域内左对齐） -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="总览" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="延时启动的整体状态：条目分布、最大延时、调度任务开关与最近一次运行结果。" />
            </StackPanel>

            <!-- 上次运行结果横幅（FR-6.7）：只在有失败时出现 -->
            <InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                Message="{x:Bind ViewModel.LastRunBanner, Mode=OneWay}"
                Severity="Warning"
                Title="上次运行有失败" />

            <!-- ── 延时启动 ── -->
            <TextBlock
                Margin="0,28,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="延时启动" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="当前已接管的条目，按来源分布。点击进入延时启动页。" />

            <!-- 延时区的 5 个 chip 都跳「延时启动」页 -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedManual, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="手动添加" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 最大延时 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="最大延时" />
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.MaxDelayText, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="当前最长条目延时 —— 登录后最晚这个时刻，全部条目启动完毕。" />
                </StackPanel>
            </Border>

            <!-- ── 开机调度任务 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="开机调度任务" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="登录时由计划任务拉起调度器，逐条按延时启动上方条目。关闭后延时启动不再生效。" />
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="登录时自动执行延时启动" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.TaskStatusText, Mode=OneWay}" />
                    </StackPanel>
                    <!-- Round I 批复 6：ToggleSwitch 默认模板即使 On/OffContent 为空也保留内容区
                         最小宽度，右侧留白 —— MinWidth=0 让开关贴右 -->
                    <ToggleSwitch
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsTaskRegistered, Mode=OneWay}"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OnTaskToggled" />
                </Grid>
            </Border>

            <!-- ── 系统自启动项 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="系统自启动项" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="全盘扫描到的自启动条目（含未接管），点击跳转查看。" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoRegistry" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoFolder" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoTask" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoUwp" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 开机调度日志 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="{x:Bind ViewModel.RecentRunTitle, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.RecentRunSummary, Mode=OneWay}" />

            <Border
                Margin="0,10,0,0"
                Padding="16,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <StackPanel>
                    <!-- 最近调度小表也带表头（自查补齐，列宽与行一致：110/*/90/70） -->
                    <Grid Padding="4,6,4,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="时间" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="程序" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="延时" />
                        <TextBlock
                            Grid.Column="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="结果" />
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentRunRows}"
                        SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunItemRow">
                            <Grid Padding="4,3" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LaunchedAtText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DelayText}" />
                                <!-- 🔴 结果列刻意放**两份**互斥的 TextBlock，不用「转换器返回 null」的写法：
                                     显式把 Foreground 绑成 null 会切断前景的继承链，文字变成不可见
                                     （真机表现：成功项整列空白，失败项因为拿到红刷反而看得见）。
                                     非失败那份不设 Foreground，沿用控件默认前景，明暗主题都正确。 -->
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateText}"
                                    Visibility="{x:Bind IsFailed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{x:Bind IsFailed, Converter={StaticResource BoolToBrush}, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateText}"
                                    Visibility="{x:Bind IsFailed, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="完整历史在「运行日志」页，保留最近 30 次。"
                Visibility="{x:Bind ViewModel.RecentRunEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
        </StackPanel>
    </ScrollView>
</Page>
