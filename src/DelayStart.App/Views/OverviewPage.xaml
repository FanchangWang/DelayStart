<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:DelayStart.App.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- 分节标题（参考 PowerToys 子标题字号，SubtitleTextBlockStyle 的 20px 太大） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 计数 chip：两排统一最小宽度 -->
        <Style x:Key="CountChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- chip 内容（数字 + 文字）整体居中 -->
        <Style x:Key="ChipContentStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!--
        「总览」页 UI v3（2026-09-21 批复）：
        ① 「最大延时」分节删除 —— 意义不大；
        ② 顶部「上次运行有失败」InfoBar 删除 —— 失败信息由「最近一次开机调度」结果列的红色承担；
        ③ 「开机调度任务」从开关改为**状态卡**：本软件强依赖调度器，任务缺失即自动补建
           （App 启动时 SchedulerTaskBootstrap 先做一轮），失败态红字强提示 +「重试创建」按钮；
        ④ 分节顺序：延时启动 → 开机调度任务 → 系统自启动项 → 最近一次开机调度；
        ⑤ 最近调度卡片：有记录时底部是「查看运行日志 →」跳转，无记录时居中空状态；
        ⑥ 各分节不再摆描述文字（信息量不足的描述直接删）。
    -->
    <ScrollView>
        <StackPanel Padding="32,8,32,40" HorizontalAlignment="Stretch" MaxWidth="1000">

            <!-- 页头 -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="总览" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="延时启动的整体状态：条目分布、调度任务与最近一次运行结果。" />
            </StackPanel>

            <!-- ── 延时启动 ── -->
            <TextBlock
                Margin="0,28,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="延时启动" />

            <!-- 延时区的 5 个 chip 都跳「延时启动」页 -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoDelay" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.DelayedManual, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="手动添加" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 开机调度任务：状态卡（2026-09-21 批复：开关删除，缺失自动补建） ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="开机调度任务" />

            <!-- 正常态 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.TaskReady, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="调度任务已就绪" VerticalAlignment="Center" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="✓ 已启用" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.TaskStatusDetail, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- 失败态：红字强提示 + 重试 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.TaskReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                FontWeight="SemiBold"
                                Text="调度任务创建失败" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="✕ 未就绪" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.TaskStatusDetail, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.EnsureTaskCommand, Mode=OneWay}"
                        Content="重试创建"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!-- ── 系统自启动项 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="系统自启动项" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <Button Click="OnGoRegistry" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedRegistry, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="注册表" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoFolder" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedFolder, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="启动文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoTask" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedTask, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="计划任务" />
                    </StackPanel>
                </Button>
                <Button Click="OnGoUwp" Style="{StaticResource CountChipStyle}">
                    <StackPanel Style="{StaticResource ChipContentStyle}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="{x:Bind ViewModel.ScannedUwp, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" Text="UWP Apps" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── 最近一次开机调度 ── -->
            <TextBlock
                Margin="0,32,0,2"
                Style="{StaticResource SectionHeaderStyle}"
                Text="最近一次开机调度" />

            <!-- 有记录：小表（列头列内居中）+ 底部跳转 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.RecentRunEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneWay}">
                <StackPanel>
                    <!-- 列宽与行一致：110/*/90/70 -->
                    <Grid Padding="4,6,4,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="时间" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="程序" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="延时" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="结果" />
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentRunRows}"
                        SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunItemRow">
                            <Grid Padding="4,3" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LaunchedAtText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DelayText}" />
                                <!-- 🔴 结果列刻意放**两份**互斥的 TextBlock，不用「转换器返回 null」的写法：
                                     显式把 Foreground 绑成 null 会切断前景的继承链，文字变成不可见
                                     （真机表现：成功项整列空白，失败项因为拿到红刷反而看得见）。
                                     非失败那份不设 Foreground，沿用控件默认前景，明暗主题都正确。 -->
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateText}"
                                    Visibility="{x:Bind IsFailed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Negate, Mode=OneTime}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{x:Bind IsFailed, Converter={StaticResource BoolToBrush}, Mode=OneTime}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateText}"
                                    Visibility="{x:Bind IsFailed, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                    <!-- 底部跳转（2026-09-21 批复：替代原"完整历史见…"的说明文字） -->
                    <HyperlinkButton
                        Padding="0,4,0,6"
                        HorizontalAlignment="Right"
                        Click="OnGoRuns"
                        Content="查看运行日志 →" />
                </StackPanel>
            </Border>

            <!-- 无记录：居中空状态 -->
            <Border
                Margin="0,10,0,0"
                Padding="16,36"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{x:Bind ViewModel.RecentRunEmpty, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="还没有调度记录" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        Text="接管条目并重启后，每次登录的启动结果都会出现在这里" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</Page>
