<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stc="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctl="using:DelayStart.App.Controls"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 分节标题（批复 3：参考 PowerToys 子标题字号，SubtitleTextBlockStyle 的 20px 太大） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 可展开一节的节头：整行都是一个按钮（点哪儿都能展开/收起）。
             🔴 节头**本身就是那张卡片**（2026-09-23 批复 25）——
             卡面 / 描边 / 圆角 / 内边距全都长在这个按钮上，外面**不再套 Border**。
             原因（上一版吃过的亏）：套一层 Border 时，按钮的悬停高亮只能铺在
             Border 的内边距以内（四周各让出 16 / 14，圆角还比卡片小一圈），
             鼠标移上去看到的是"文字那一小块变色了"，而不是整张卡片响应。
             卡面交给按钮后，PointerOver 会同时换掉
             CardBackgroundFillColorDefaultBrush → ButtonBackgroundPointerOver
             与 CardStrokeColorDefaultBrush → ButtonBorderBrushPointerOver，
             整行连描边、圆角一起变化；Pressed 同理（视觉状态来自 DefaultButtonStyle）。
             与外层卡片的几何完全一致：1px 描边 + 圆角 7 + 内边距 16,14。 -->
        <Style
            x:Key="SectionHeaderButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <!--
        「设置」页（FR-9，UI v2.2 重做）：
        ① 没有「保存」按钮 —— 所有操作立即落盘生效；
        ② 降权 / 托盘设置已移除（语义固定，不再可配）；
        ③ 新增主题设置（跟随系统 / 浅色 / 深色）；
        ④ 预设延时为列表：其中一项是默认值 —— 接管条目时自动填入；行内可设为默认 / 删除。
        ⑤ 卡片用 PowerToys 同款 SettingsCard（D1 批复 A）；
        ⑥ 2026-09-20 批复修订：
           - 限宽回 1000 并居中 —— 已核实 PowerToys 源码（Settings.UI/SettingsXAML/App.xaml）：
             <x:Double x:Key="PageMaxWidth">1000</x:Double>，PageStyle 把它挂在内容容器上；
           - 预设延时两个边框：第一个左描述右（输入框 + 添加按钮），第二个胶囊一行多个。
        ⑦ 2026-09-22 批复（D80）：新增「守卫」分节，目前只有一项「通知策略」
           （有变化时通知 / 从不通知）。它管的是守卫发现自启动项变化后发不发系统通知；
           「调度」分节里的同名卡片管的是调度结束后发不发系统通知（N3 批复前管弹不弹面板）
           —— 两个同名卡片触发方与载体都不同，互不相干。
        ⑧ 2026-09-23 批复 24（「延时」「周期」两节重排）：
           - 节头 = **一个可展开的整行**：左字 + 描述，右端一枚**纯图标**三角
             （上一版是 ToggleButton，看起来像颗按钮 —— 用户点名改掉）；
             「＋ 新建」不再挤在这一行里，它自己单独一行；
           - 展开后子内容**左右各内收 16**，一眼看出是上级的子内容；
           - 子内容第一条固定是「添加」：左侧一句描述 + 右侧添加按钮；
             第二条起才是真正的数据行（延时值 / 周期）。
        ⑨ 2026-09-23 批复 25（节头悬停范围）：
           - 节头**不再套 Border**，卡面 / 描边 / 圆角 / 内边距全部长在按钮上。
             套 Border 时按钮的悬停高亮只铺在内边距以内（四周各让出 16 / 14、
             圆角还小一圈），看起来是"文字那一小块变色"；现在整张卡片连描边一起响应。
    -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <!-- 2026-09-21 批复：与总览页同一版式 —— 页头在限宽容器内、随内容滚动，
                 内边距计入 MaxWidth（总览：Padding 32,8,32,40 + MaxWidth 1000 → 内容 936）。
                 子标题字号/间距沿用总览的 SectionHeaderStyle + Margin 0,28,0,2。 -->
            <StackPanel Padding="32,8,32,40" HorizontalAlignment="Stretch" MaxWidth="1000" Spacing="4">

                <!-- 页头 -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="所有改动即时保存，下次登录调度即按新值执行。" />
                </StackPanel>

                <!-- ── 外观 ──（2026-09-20 批复：提到最前，作为第一个子标题） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="外观" />

                <StackPanel Spacing="2">
                    <stc:SettingsCard Description="切换立即生效，跟随系统时随 Windows 深浅色变化" Header="主题">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                            SelectionChanged="OnThemeChanged" />
                    </stc:SettingsCard>
                </StackPanel>

                <!-- ── 延时 ──（2026-09-23 批复 24：可展开的整行节头 + 内收的子内容。） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="延时" />

                <!-- 节头：整行可点；卡面/描边长在按钮上（见 SectionHeaderButtonStyle），
                     所以这里不再套 Border —— 悬停时整张卡片连描边一起响应。
                     右端三角是**纯图标**，不是按钮。 -->
                <Button
                    Click="OnPresetSectionToggle"
                    Style="{StaticResource SectionHeaderButtonStyle}"
                    ToolTipService.ToolTip="展开或收起预设延时列表">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="预设延时" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="编辑器快选按钮用的延时列表，其中一项为默认值。" />
                        </StackPanel>

                        <!-- 🔴 纯图标：不套 ToggleButton，没有自己的背景/边框/悬停态 ——
                             点它就等于点整行（它落在同一个按钮的内容里）。 -->
                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="{x:Bind ViewModel.DelaySectionGlyph, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- 子内容：左右各内收 16（一眼看出是上级的子内容）。
                     第一条固定是「添加」行，之后每个预设延时一条边框。 -->
                <StackPanel
                    Margin="16,8,16,0"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsDelaySectionExpanded, Mode=OneWay}">

                    <Border
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBlock Text="新建预设延时" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Text="按秒填写；同一个值不会重复添加。" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnPresetAddDialog"
                                Content="＋ 新建延时" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Presets, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetRow">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <!-- 固定宽度：让「设为默认」按钮与「当前默认」文字占同一个格，
                                                 两种形态下最右的「删除」始终对齐。 -->
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Display}" />

                                        <!-- 默认行：不再挂一个"点了没用"的按钮，直接说明它已经是当前默认。
                                             绿色沿用全站"状态正常"的表达（总览 / 主窗同色）。 -->
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="当前默认"
                                            Visibility="{x:Bind IsDefault}" />

                                        <!-- 非默认行：一键设为默认（原来靠点整行，形态改了就换成显式按钮）。 -->
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="OnPresetSetDefault"
                                            Content="设为默认"
                                            ToolTipService.ToolTip="接管条目时自动填入这个延时"
                                            Visibility="{x:Bind IsNotDefault}" />

                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="OnPresetDelete"
                                            Content="删除"
                                            IsEnabled="{x:Bind CanDelete, Mode=OneTime}"
                                            ToolTipService.ToolTip="从快选列表移除" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── 周期 ──（FR-15；2026-09-23 批复 24：与「延时」同一套版式 ——
                     可展开的整行节头 + 内收的子内容，第一条为「新建」。） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="周期" />

                <!-- 与「延时」同一套版式：整行可点，卡面长在按钮上（不套 Border） -->
                <Button
                    Click="OnCycleSectionToggle"
                    Style="{StaticResource SectionHeaderButtonStyle}"
                    ToolTipService.ToolTip="展开或收起周期列表">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="调度周期" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="决定条目在哪些天启动。前 5 个是内置周期，不能改也不能删。" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="{x:Bind ViewModel.CycleSectionGlyph, Mode=OneWay}" />
                    </Grid>
                </Button>

                <StackPanel
                    Margin="16,8,16,0"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsCycleSectionExpanded, Mode=OneWay}">

                    <Border
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBlock Text="新建周期" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Text="自己指定一周里的哪几天。" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnCycleAdd"
                                Content="＋ 新建周期" />
                        </Grid>
                    </Border>

                    <!-- 内置 5 档在前、我的周期在后，一张一行（批复 6：不挤在一张卡里） -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Cycles, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CycleRow">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DaysText}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind UsageText}" />
                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <!-- 🔴 内置档与被引用的自定义周期都置灰（FR-15.13 / FR-15.14）：
                                                 x:Bind 不支持取反，也**不该**在这里重算一遍判据 ——
                                                 结论由 CycleRow.CanEdit / CanDelete 给出。 -->
                                            <Button
                                                Click="OnCycleEdit"
                                                Content="编辑"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneTime}"
                                                ToolTipService.ToolTip="{x:Bind EditToolTip}" />
                                            <Button
                                                Click="OnCycleDelete"
                                                Content="删除"
                                                IsEnabled="{x:Bind CanDelete, Mode=OneTime}"
                                                ToolTipService.ToolTip="{x:Bind DeleteToolTip}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2026-09-23 批复 16：周期节底部原先有两句常驻说明（"周期是引用关系…"
                     与空状态"还没有自定义周期"），已移除 —— 该说的在编辑面板副标题
                     （N 个条目正在使用）与删除确认里都已经说过，常驻在设置页只是噪声。 -->

                <!-- ── 节假日数据 ──（FR-15 / §6.5：今年 + 次年两行，逐行状态 + 更新入口） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="节假日数据" />

                <StackPanel Spacing="2">
                    <!-- 2026-09-23 二次批复 2：点下去必须当场有可见反馈。
                         更新要走网络（三个地址依次降级，最坏十几秒），期间什么都不显示的话，
                         用户只会得出"这按钮坏了"这一个结论。
                         2026-09-23 批复 20：改绑**共享状态**（ViewModel.HolidayStatus）——
                         启动时的自动检查也在往同一个对象上报，于是"自动检查跑到一半进设置页"
                         同样能看见这条进度，而不只是本页按钮触发的那一次。 -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HolidayStatus.IsBusy, Mode=OneWay}"
                        Message="{x:Bind ViewModel.HolidayStatus.ActivityText, Mode=OneWay}"
                        Severity="Informational" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HolidayYears, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HolidayYearRow">
                                <stc:SettingsCard Description="{x:Bind DetailText}" Header="{x:Bind Header}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusText}" />
                                        <!-- 🔴 行对象用 Tag 显式带上，不靠 DataContext 继承 ——
                                             这些按钮长在 SettingsCard 的 Content 里，而 Content 区的
                                             DataContext 继承链不可靠：卡片标题显示正常**不能**证明
                                             内容区的 DataContext 是对的（标题走的是 x:Bind 编译期引用）。
                                             取不到行的后果是静默 return，表现就是"点了没反应"。 -->
                                        <Button
                                            Click="OnHolidayUpdateYear"
                                            Content="重新下载"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="强制从网络重新拉取这一年的数据" />
                                        <!-- 没有本地数据就没有东西可导：按钮置灰（IsEnabled 取自行对象）。 -->
                                        <Button
                                            Click="OnHolidayExportYear"
                                            Content="导出"
                                            IsEnabled="{x:Bind CanExport, Mode=OneTime}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="把这年的本地数据存成 JSON 文件" />
                                    </StackPanel>
                                </stc:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <stc:SettingsCard Description="只补缺失的年份；已有合法数据时不会白跑一趟网络" Header="补齐缺失年份">
                        <!-- 绑的是"空闲"不是"忙"：x:Bind 不支持取反，直接绑忙标志
                             会让按钮在闲时锁死、忙时可点（2026-09-23 二次批复 2 修正）。
                             批复 20 起改绑共享状态 —— 自动检查在跑的时候，这里的按钮同样该禁用。 -->
                        <Button
                            Click="OnHolidayUpdateMissing"
                            Content="立即更新"
                            IsEnabled="{x:Bind ViewModel.HolidayStatus.IsIdle, Mode=OneWay}" />
                    </stc:SettingsCard>

                    <!-- 副标题改成**活的**（2026-09-23 批复 20）：原先写的是规则说明
                         （"当年数据不可用时…"），用户看完仍然不知道"它到底跑没跑"。
                         现在这里直接报事实：关着 / 已就绪 / 上次什么时候查的、结果如何。 -->
                    <stc:SettingsCard
                        Description="{x:Bind ViewModel.HolidayStatus.SummaryText, Mode=OneWay}"
                        Header="自动检查更新">
                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.AutoCheckHolidayUpdates, Mode=OneWay}"
                            Toggled="OnHolidayAutoCheckToggled" />
                    </stc:SettingsCard>

                    <stc:SettingsCard Description="原始格式（holiday-cn 的 days）与本程序导出的归一化格式都能直接导入，年份以文件内容为准" Header="从文件导入">
                        <Button Click="OnHolidayImport" Content="选择文件" />
                    </stc:SettingsCard>

                    <stc:SettingsCard Description="本地数据所在目录，可手工替换或校正" Header="数据文件夹">
                        <Button Click="OnHolidayOpenFolder" Content="打开" />
                    </stc:SettingsCard>
                </StackPanel>

                <!-- ── 调度 ── -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="调度" />

                <StackPanel Spacing="2">
                    <!-- N3（2026-09-22 批复）：通知策略语义从"弹不弹面板"改为"发不发系统通知"，
                         文案随之精简（完整机制见 docs/notify-broker-plan.md §4.1 → design.md FR-14）。 -->
                    <stc:SettingsCard Description="启动计划全部结束后，按所选策略发送系统通知" Header="通知策略">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.NotifyModes}"
                            SelectedIndex="{x:Bind ViewModel.NotifyModeIndex, Mode=TwoWay}"
                            SelectionChanged="OnNotifyModeChanged" />
                    </stc:SettingsCard>
                    <stc:SettingsCard Description="同一次运行内的重试次数（0–5）" Header="重试次数">
                        <NumberBox
                            MinWidth="120"
                            Maximum="5"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnRetryChanged"
                            Value="{x:Bind ViewModel.RetryCount, Mode=TwoWay}" />
                    </stc:SettingsCard>
                </StackPanel>

                <!-- ── 守卫 ──（2026-09-22 批复：新增分节，目前只有通知策略一项） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="守卫" />

                <StackPanel Spacing="2">
                    <stc:SettingsCard Description="发现自启动项变化时发送系统通知；纠正与记录不受影响" Header="通知策略">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.GuardNotifyModes}"
                            SelectedIndex="{x:Bind ViewModel.GuardNotifyModeIndex, Mode=TwoWay}"
                            SelectionChanged="OnGuardNotifyModeChanged" />
                    </stc:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollView>

        <!-- 状态条：只报错（2026-09-21 批复：成功类提示改走右下角自动消失的通知） -->
        <InfoBar
            Grid.Row="1"
            Margin="32,0,32,4"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
