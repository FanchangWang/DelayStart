<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stc="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctl="using:DelayStart.App.Controls"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 分节标题（批复 3：参考 PowerToys 子标题字号，SubtitleTextBlockStyle 的 20px 太大） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <!--
        「设置」页（FR-9，UI v2.2 重做）：
        ① 没有「保存」按钮 —— 所有操作立即落盘生效；
        ② 降权 / 托盘设置已移除（语义固定，不再可配）；
        ③ 新增主题设置（跟随系统 / 浅色 / 深色）；
        ④ 预设延时为胶囊快选：胶囊选中即默认 —— 接管条目时自动填入；胶囊内的 ✕ 删除。
        ⑤ 卡片用 PowerToys 同款 SettingsCard（D1 批复 A）；
        ⑥ 2026-09-20 批复修订：
           - 限宽回 1000 并居中 —— 已核实 PowerToys 源码（Settings.UI/SettingsXAML/App.xaml）：
             <x:Double x:Key="PageMaxWidth">1000</x:Double>，PageStyle 把它挂在内容容器上；
           - 预设延时两个边框：第一个左描述右（输入框 + 添加按钮），第二个胶囊一行多个。
        ⑦ 2026-09-22 批复（D80）：新增「守卫」分节，目前只有一项「通知策略」
           （有变化时通知 / 从不通知）。它管的是守卫发现自启动项变化后发不发系统通知；
           「调度」分节里的同名卡片管的是调度结束后发不发系统通知（N3 批复前管弹不弹面板）
           —— 两个同名卡片触发方与载体都不同，互不相干。
    -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <!-- 2026-09-21 批复：与总览页同一版式 —— 页头在限宽容器内、随内容滚动，
                 内边距计入 MaxWidth（总览：Padding 32,8,32,40 + MaxWidth 1000 → 内容 936）。
                 子标题字号/间距沿用总览的 SectionHeaderStyle + Margin 0,28,0,2。 -->
            <StackPanel Padding="32,8,32,40" HorizontalAlignment="Stretch" MaxWidth="1000" Spacing="4">

                <!-- 页头 -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="所有改动即时保存，下次登录调度即按新值执行。" />
                </StackPanel>

                <!-- ── 外观 ──（2026-09-20 批复：提到最前，作为第一个子标题） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="外观" />

                <StackPanel Spacing="2">
                    <stc:SettingsCard Description="切换立即生效，跟随系统时随 Windows 深浅色变化" Header="主题">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                            SelectionChanged="OnThemeChanged" />
                    </stc:SettingsCard>
                </StackPanel>

        <!-- ── 预设延时 ──（2026-09-21 批复：分节描述移入下方胶囊卡片内部） -->
        <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="延时" />

        <!-- 边框一：左描述 + 右（输入框 + 添加按钮），仿 PowerToys「颜色格式」卡片 -->
        <Border
            Padding="16,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="7">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="添加预设延时" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="单位为秒；相同值不会重复添加。" />
                </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <NumberBox
                                Header=""
                                Minimum="0"
                                Width="140"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.NewPresetValue, Mode=TwoWay}" />
                            <Button
                                VerticalAlignment="Center"
                                Click="OnPresetAdd"
                                Content="添加" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 边框二：胶囊一行多个（2026-09-20 批复 6：恢复横排）。
                     🔴 不用 GridView / WrapGrid：两者按统一单元格布局，长文本被截断。
                     单选互斥在 code-behind（OnPresetChecked）里做。 -->
                <Border
                    Margin="0,8,0,0"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <StackPanel Spacing="8">
                        <!-- 2026-09-21 批复：原分节描述移到卡片内部（删掉 ✕ / 右侧等纯位置描述） -->
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="编辑器快选按钮使用的延时列表，高亮胶囊为默认值，接管条目时自动填入。点击垃圾桶移除，删除前会二次确认。" />
                        <ItemsControl
                            x:Name="PresetPills"
                            ItemsSource="{x:Bind ViewModel.Presets, Mode=OneTime}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Round H 批复 7：超宽自动换行（自绘 WrapPanel，宽度仍按内容自适应） -->
                                <ctl:WrapPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetRow">
                                <ToggleButton
                                    Checked="OnPresetChecked"
                                    CornerRadius="14"
                                    IsChecked="{x:Bind IsDefault, Mode=OneTime}"
                                    Padding="10,5"
                                    Unchecked="OnPresetUnchecked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Display}" />
                                        <!-- 垃圾桶：2026-09-21 二次批复回退为嵌套 Button ——
                                             裸 TextBlock + PointerEntered/Tapped 方案触发 XamlCompiler
                                             pass-1 静默崩溃（无 output.json），且悬停变色难以两主题兼顾。
                                             主题同色问题接受现状（此功能可忽略）。 -->
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnPresetDelete"
                                            Content="&#xE74D;"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="12"
                                            IsEnabled="{x:Bind CanDelete, Mode=OneTime}"
                                            Padding="4,2"
                                            ToolTipService.ToolTip="删除这个预设" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── 周期 ──（FR-15，2026-09-23 批复 6：位置在「延时」与「节假日数据」之间；
                     边框一固定是"介绍 + 新建"，之后每个自定义周期一张独立边框，
                     内置 5 档不出现在这里 —— 它们在延时弹窗里挑，且不可改不可删。） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="周期" />

                <!-- 边框一：左介绍 + 右（新建按钮） -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="决定条目在哪些天启动" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="一个周期可被多个条目引用；改周期会同步影响所有引用它的条目。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnCycleAdd"
                            Content="＋ 新建周期" />
                    </Grid>
                </Border>

                <!-- 每个自定义周期一张独立边框（批复 6：不挤在一张卡里） -->
                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.Cycles, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CycleRow">
                            <Border
                                Margin="0,0,0,8"
                                Padding="16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DaysText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind UsageText}" />
                                    <StackPanel
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="OnCycleEdit"
                                            Content="编辑"
                                            ToolTipService.ToolTip="{x:Bind EditToolTip}" />
                                        <!-- 🔴 被引用时置灰（FR-15.14）：x:Bind 不支持取反，
                                             结论由 CycleRow.CanDelete 给出，XAML 不做判断。 -->
                                        <Button
                                            Click="OnCycleDelete"
                                            Content="删除"
                                            IsEnabled="{x:Bind CanDelete, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind DeleteToolTip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2026-09-23 批复 16：周期节底部原先有两句常驻说明（"周期是引用关系…"
                     与空状态"还没有自定义周期"），已移除 —— 该说的在编辑面板副标题
                     （N 个条目正在使用）与删除确认里都已经说过，常驻在设置页只是噪声。 -->

                <!-- ── 节假日数据 ──（FR-15 / §6.5：今年 + 次年两行，逐行状态 + 更新入口） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="节假日数据" />

                <StackPanel Spacing="2">
                    <!-- 2026-09-23 二次批复 2：点下去必须当场有可见反馈。
                         更新要走网络（三个地址依次降级，最坏十几秒），期间什么都不显示的话，
                         用户只会得出"这按钮坏了"这一个结论。
                         2026-09-23 批复 20：改绑**共享状态**（ViewModel.HolidayStatus）——
                         启动时的自动检查也在往同一个对象上报，于是"自动检查跑到一半进设置页"
                         同样能看见这条进度，而不只是本页按钮触发的那一次。 -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HolidayStatus.IsBusy, Mode=OneWay}"
                        Message="{x:Bind ViewModel.HolidayStatus.ActivityText, Mode=OneWay}"
                        Severity="Informational" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HolidayYears, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HolidayYearRow">
                                <stc:SettingsCard Description="{x:Bind DetailText}" Header="{x:Bind Header}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusText}" />
                                        <!-- 🔴 行对象用 Tag 显式带上，不靠 DataContext 继承 ——
                                             这些按钮长在 SettingsCard 的 Content 里，而 Content 区的
                                             DataContext 继承链不可靠：卡片标题显示正常**不能**证明
                                             内容区的 DataContext 是对的（标题走的是 x:Bind 编译期引用）。
                                             取不到行的后果是静默 return，表现就是"点了没反应"。 -->
                                        <Button
                                            Click="OnHolidayUpdateYear"
                                            Content="重新下载"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="强制从网络重新拉取这一年的数据" />
                                        <!-- 没有本地数据就没有东西可导：按钮置灰（IsEnabled 取自行对象）。 -->
                                        <Button
                                            Click="OnHolidayExportYear"
                                            Content="导出"
                                            IsEnabled="{x:Bind CanExport, Mode=OneTime}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="把这年的本地数据存成 JSON 文件" />
                                    </StackPanel>
                                </stc:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <stc:SettingsCard Description="只补缺失的年份；已有合法数据时不会白跑一趟网络" Header="补齐缺失年份">
                        <!-- 绑的是"空闲"不是"忙"：x:Bind 不支持取反，直接绑忙标志
                             会让按钮在闲时锁死、忙时可点（2026-09-23 二次批复 2 修正）。
                             批复 20 起改绑共享状态 —— 自动检查在跑的时候，这里的按钮同样该禁用。 -->
                        <Button
                            Click="OnHolidayUpdateMissing"
                            Content="立即更新"
                            IsEnabled="{x:Bind ViewModel.HolidayStatus.IsIdle, Mode=OneWay}" />
                    </stc:SettingsCard>

                    <!-- 副标题改成**活的**（2026-09-23 批复 20）：原先写的是规则说明
                         （"当年数据不可用时…"），用户看完仍然不知道"它到底跑没跑"。
                         现在这里直接报事实：关着 / 已就绪 / 上次什么时候查的、结果如何。 -->
                    <stc:SettingsCard
                        Description="{x:Bind ViewModel.HolidayStatus.SummaryText, Mode=OneWay}"
                        Header="自动检查更新">
                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.AutoCheckHolidayUpdates, Mode=OneWay}"
                            Toggled="OnHolidayAutoCheckToggled" />
                    </stc:SettingsCard>

                    <stc:SettingsCard Description="原始格式（holiday-cn 的 days）与本程序导出的归一化格式都能直接导入，年份以文件内容为准" Header="从文件导入">
                        <Button Click="OnHolidayImport" Content="选择文件" />
                    </stc:SettingsCard>

                    <stc:SettingsCard Description="本地数据所在目录，可手工替换或校正" Header="数据文件夹">
                        <Button Click="OnHolidayOpenFolder" Content="打开" />
                    </stc:SettingsCard>
                </StackPanel>

                <!-- ── 调度 ── -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="调度" />

                <StackPanel Spacing="2">
                    <!-- N3（2026-09-22 批复）：通知策略语义从"弹不弹面板"改为"发不发系统通知"，
                         文案随之精简（完整机制见 docs/notify-broker-plan.md §4.1 → design.md FR-14）。 -->
                    <stc:SettingsCard Description="启动计划全部结束后，按所选策略发送系统通知" Header="通知策略">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.NotifyModes}"
                            SelectedIndex="{x:Bind ViewModel.NotifyModeIndex, Mode=TwoWay}"
                            SelectionChanged="OnNotifyModeChanged" />
                    </stc:SettingsCard>
                    <stc:SettingsCard Description="同一次运行内的重试次数（0–5）" Header="重试次数">
                        <NumberBox
                            MinWidth="120"
                            Maximum="5"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnRetryChanged"
                            Value="{x:Bind ViewModel.RetryCount, Mode=TwoWay}" />
                    </stc:SettingsCard>
                </StackPanel>

                <!-- ── 守卫 ──（2026-09-22 批复：新增分节，目前只有通知策略一项） -->
                <TextBlock Margin="0,28,0,2" Style="{StaticResource SectionHeaderStyle}" Text="守卫" />

                <StackPanel Spacing="2">
                    <stc:SettingsCard Description="发现自启动项变化时发送系统通知；纠正与记录不受影响" Header="通知策略">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.GuardNotifyModes}"
                            SelectedIndex="{x:Bind ViewModel.GuardNotifyModeIndex, Mode=TwoWay}"
                            SelectionChanged="OnGuardNotifyModeChanged" />
                    </stc:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollView>

        <!-- 状态条：只报错（2026-09-21 批复：成功类提示改走右下角自动消失的通知） -->
        <InfoBar
            Grid.Row="1"
            Margin="32,0,32,4"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
