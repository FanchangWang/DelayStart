<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelayStart.App.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:m="using:DelayStart.Management.Models"
    xmlns:vm="using:DelayStart.App.ViewModels"
    mc:Ignorable="d">

    <!--
        「系统启动项」页（FR-7，全部只读）。
        服务 / 驱动 / Winlogon / 登录脚本 —— 本程序**永远不会碰它们**，只展示，
        让用户知道还有哪些启动位置不在本程序的管辖范围。
    -->
    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="系统启动项" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="以下内容供了解系统现状用。本程序不会禁用、修改或延迟它们 —— 它们只能用系统自带工具（services.msc / 任务管理器）管理。"
            Severity="Informational"
            Title="本页全部只读" />

        <!-- 加载条 + 内置过滤开关（D2/D3）：默认只看第三方，标题栏数字会随开关变 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <ProgressBar
                IsIndeterminate="True"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <CheckBox
                HorizontalAlignment="Right"
                IsChecked="{x:Bind ViewModel.ShowBuiltinServices, Mode=TwoWay}"
                Content="显示 Windows 内置服务 / 驱动" />
        </Grid>

        <!-- 分区折叠展示：服务 / 驱动 / Winlogon / 登录脚本 -->
        <ScrollView Grid.Row="3">
            <StackPanel Spacing="8">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ServicesHeaderText, Mode=OneWay}" />
                    </Expander.Header>
                    <ListView ItemsSource="{x:Bind ViewModel.Services}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:ServiceInfo">
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ServiceName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StartType}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalTextAlignment="Right"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DelayedAutoText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.DriversHeaderText, Mode=OneWay}" />
                    </Expander.Header>
                    <ListView ItemsSource="{x:Bind ViewModel.Drivers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:ServiceInfo">
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ServiceName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StartType}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.WinlogonHeaderText, Mode=OneWay}" />
                    </Expander.Header>
                    <ListView ItemsSource="{x:Bind ViewModel.WinlogonEntries}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:ReadOnlyEntry">
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Location}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ScriptsHeaderText, Mode=OneWay}" />
                    </Expander.Header>
                    <ListView ItemsSource="{x:Bind ViewModel.LogonScripts}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:ReadOnlyEntry">
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
