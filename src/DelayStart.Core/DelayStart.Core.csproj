<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DelayStart.Core</RootNamespace>

    <!--
      ★ 架构护栏（docs/docs/design.md 7.1）。
      开启后编译器在构建期报出 AOT 不兼容的 API 使用（IL2026 / IL3050）。
      Core 被 NativeAOT 的调度端引用，**绝不能**混入 COM 互操作或反射代码——
      这类代码属于 DelayStart.Management。
    -->
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      ★ LibraryImport 源生成器生成不安全代码（坑 2，本机实测）。
      Phase 4 加入 P/Invoke 启动器（D27=A）后必须开启。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    单元测试需要直接调用 Core 内部的**纯判定**（ElevationCheck.IsElevatedFromTokenInfo、
    BrokerTimingPolicy、DeElevatedProcessLauncher 的 UWP / UIAccess 判据面）。
    这些判定此前要么零覆盖，要么只能靠反射触达 —— 反射进私有方法的测试要等方法改名
    才炸，且拿不到编译期类型检查。管理端项目已有同样的配置，两处保持一致。
    ⚠️ 放宽的只是 internal 的**可见性**，不是行为：判定逻辑一字未改。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DelayStart.Core.Tests" />
  </ItemGroup>

</Project>
