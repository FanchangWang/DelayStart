<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DelayStart.Management</RootNamespace>
    <!-- 不要求 AOT 安全：本层含 COM 互操作（IShellLink / IShellItemImageFactory）
         与 Microsoft.Win32.TaskScheduler，二者都与 NativeAOT 不兼容。见 docs/design.md 7.1。 -->

    <!-- 坑 9（pitfalls.md 四）：[LibraryImport] 的源生成器产出带指针的代码，
         必须开 AllowUnsafeBlocks，否则报 SYSLIB1062 + CS0227。
         本层**没有** AOT 约束，开它不违背任何架构护栏；Core 侧仍然禁止 P/Invoke。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DelayStart.Core\DelayStart.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 计划任务机制的内部纯函数（如 ScheduledTaskGateway.SameAccount）要进单测；
         只对测试程序集开放 internal 可见性，不扩大公共 API 面。 -->
    <InternalsVisibleTo Include="DelayStart.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 计划任务的创建 / 更新 / 查询（FR-11.3 明确要求用 API 而非 schtasks.exe）。
         注意包 id 是 TaskScheduler，理由见 Directory.Packages.props 的注释。 -->
    <PackageReference Include="TaskScheduler" />
  </ItemGroup>

</Project>
