<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DelayStart.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      ★ OutputType=Exe 是 xUnit v3 的**硬要求**（测试项目本身是可执行程序，
      走 Microsoft.Testing.Platform 自托管）。
      缺了它会直接报：xUnit.net v3 test projects must be executable。
    -->
    <OutputType>Exe</OutputType>

    <!--
      ★ 测试项目只引用普通类库（Core / Management），**不引用 DelayStart.App**。
      测试项目 TFM 因此只需 net10.0-windows：不需要 WindowsAppSDKSelfContained、
      不需要预装 Windows App Runtime、不需要 RuntimeIdentifiers。
      任何"让测试引用 WinUI 3 项目"的改动都会把这些包袱全部带回来。见 architecture.md 1.3。

      OutputType=Exe 是 xUnit v3 的要求（测试项目本身是可执行程序），模板已生成。
      测试以**普通权限**运行，不得要求管理员，不得触碰真实注册表 / 文件 / 进程。
    -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DelayStart.Core\DelayStart.Core.csproj" />
    <ProjectReference Include="..\..\src\DelayStart.Management\DelayStart.Management.csproj" />
  </ItemGroup>

</Project>
